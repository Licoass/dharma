# ========================================================
# DHARMA — VARIABLES DE ENTORNO
# ========================================================

# Supabase Project URL (para conectar con la Edge Function 'dharma-core')
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase Anon Key pública (segura para frontend)
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# URL directa opcional de la Edge Function (si se usa endpoint personalizado o local)
# VITE_DHARMA_CORE_FUNCTION_URL=https://tu-proyecto.supabase.co/functions/v1/dharma-core

# ========================================================
# IMPORTANTE DE SEGURIDAD:
# La clave GEMINI_API_KEY NUNCA debe colocarse en este archivo .env del frontend.
# Se configura como SECRETO en Supabase con el comando:
# supabase secrets set GEMINI_API_KEY="AIzaSy..."
# ========================================================
